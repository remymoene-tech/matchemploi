# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Adresse publique du site (sans / à la fin) ---
NEXT_PUBLIC_SITE_URL=https://ton-site.vercel.app

# --- Emails des personnes qui ont accès à l'espace admin (séparés par des virgules) ---
ADMIN_EMAILS=remy.moene@gmail.com

# --- IA : clé API Anthropic (console.anthropic.com) ---
ANTHROPIC_API_KEY=
# Modèle utilisé (facultatif). Par défaut : claude-haiku-5-5, léger et économique.
# IA_MODELE=claude-opus-5-5

# --- France Travail (francetravail.io > Mes applications) ---
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- Adzuna (developer.adzuna.com > Dashboard > API Access Details) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Envoi des emails depuis ta boîte (conseillé pour démarrer) ---
# Gmail : smtp.gmail.com, port 465, ton adresse, et un « mot de passe d'application »
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOM_EXPEDITEUR=Rémy – Jobaprox

# --- OU emails via Resend (resend.com), avec un nom de domaine vérifié ---
RESEND_API_KEY=
EMAIL_EXPEDITEUR=Jobaprox <onboarding@resend.dev>

# --- Seuil de correspondance (en %) ---
MATCH_SEUIL=75

# --- Secret de la tâche planifiée quotidienne (une longue suite de caractères au hasard) ---
CRON_SECRET=
